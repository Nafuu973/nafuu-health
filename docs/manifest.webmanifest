{
  "name": "Nafuu Health",
  "short_name": "Nafuu Health",
  "description": "Le suivi de tes séances, à la répétition.",
  "lang": "fr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#eef2f4",
  "theme_color": "#eef2f4",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./partage",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [ { "name": "fichier", "accept": ["application/json", ".json", "text/plain", "application/octet-stream"] } ]
    }
  }
}
